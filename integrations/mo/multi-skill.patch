+def copy_skills(spec):
+    names=spec.get('copy_skills',[spec.get('name','devnorm')])
+    if not isinstance(names,list) or not names or len(names)!=len(set(names)) or any(not isinstance(n,str) or not re.fullmatch(r'[a-z0-9]+(?:-[a-z0-9]+)*',n) for n in names):
+        raise ValueError('invalid or duplicate release copy_skills')
+    if spec.get('name','devnorm') not in names:raise ValueError('copy_skills must include primary skill')
+    return names
+
+def member(client,spec):
+    return client.split('/',1)[1] if '/' in client else spec.get('name','devnorm')
+
