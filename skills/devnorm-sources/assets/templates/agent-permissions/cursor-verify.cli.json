{
  "permissions": {
    "allow": [
      "Shell(git -C *)",
      "Shell(git status)",
      "Shell(git diff)",
      "Shell(git log)",
      "Shell(git show)",
      "Shell(git rev-parse)",
      "Shell(git archive)",
      "Shell(npm run)",
      "Shell(npm test)",
      "Shell(npm ci)",
      "Shell(bun)",
      "Shell(bun run)",
      "Shell(shasum)",
      "Write({{REPORT_ABS}})",
      "Write(/tmp/**)",
      "Read({{REPO_ROOT}}/**)",
      "Read(/tmp/**)"
    ],
    "deny": [
      "Shell(git push)",
      "Shell(git reset)",
      "Shell(git rebase)",
      "Shell(git checkout)",
      "Shell(git switch)",
      "Shell(git clean)",
      "Shell(git stash)",
      "Shell(git merge)",
      "Shell(git tag)",
      "Shell(git config)",
      "Shell(git commit)",
      "Shell(npm install)",
      "Shell(npm i)",
      "Shell(npm add)",
      "Shell(npm update)",
      "Shell(npm publish)",
      "Shell(npm exec)",
      "Shell(npx)",
      "Shell(bun add)",
      "Shell(bun update)",
      "Shell(bunx)",
      "Shell(curl)",
      "Shell(wget)",
      "Shell(ssh)",
      "Shell(scp)",
      "Shell(sudo)",
      "Shell(security)",
      "Shell(printenv)",
      "Write(.claude/**)",
      "Write(.cursor/**)",
      "Read(~/.ssh/**)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)"
    ]
  }
}