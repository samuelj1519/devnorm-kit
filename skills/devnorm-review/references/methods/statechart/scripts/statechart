#!/bin/sh
# DevNorm wrapper: use already-installed Java/TLC only; preserve fixed upstream runtime resources.
set -eu
if [ -z "${JAVA:-}" ] || [ -z "${TLA2TOOLS:-}" ]; then
  echo 'DevNorm statechart: set JAVA and TLA2TOOLS to existing local tools; installation is not performed.' >&2
  exit 2
fi
if [ ! -f "$TLA2TOOLS" ] || [ ! -r "$TLA2TOOLS" ]; then
  echo 'DevNorm statechart: TLA2TOOLS must be an existing readable jar.' >&2
  exit 2
fi
if ! "$JAVA" -version >/dev/null 2>&1; then
  echo 'DevNorm statechart: JAVA is unavailable or cannot run.' >&2
  exit 2
fi
if tlc_help=$("$JAVA" -cp "$TLA2TOOLS" tlc2.TLC -help 2>&1); then
  tlc_help_status=0
else
  tlc_help_status=$?
fi
tlc_available=false
case "$tlc_help_status" in
  0|1)
    case "$tlc_help" in
      *"TLC - provides model checking and simulation of TLA+ specifications - Version "*"SYNOPSIS"*) tlc_available=true ;;
    esac
    ;;
esac
if [ "$tlc_available" != true ]; then
  echo 'DevNorm statechart: TLA2TOOLS cannot run TLC with the selected JAVA.' >&2
  exit 2
fi
export JAVA TLA2TOOLS
if [ "${1:-}" = '--check-environment' ]; then
  echo 'DevNorm statechart: existing Java and TLC are available.'
  exit 0
fi
self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
upstream="$self_dir/../../../upstream/cursor-plugins/statechart/scripts/statechart"
if [ ! -f "$upstream" ]; then
  echo 'DevNorm statechart: packaged upstream runtime is missing.' >&2
  exit 2
fi
exec sh "$upstream" "$@"
